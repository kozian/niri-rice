{
    "layer": "top",
    "on-sigusr1": "toggle",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "backlight",
        "custom/network",
        "custom/battery",
        "custom/notification",
        "custom/power"
    ],
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true
    },
    "backlight": {
        "format": "  {percent}%",
        "on-scroll-up": "brightnessctl --class=backlight --min-value=1 set 5%+",
        "on-scroll-down": "brightnessctl --class=backlight --min-value=1 set 5%-"
    },
    "custom/network": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/rice-network",
        "interval": 5,
        "on-click": "foot nmtui",
        "escape": true
    },
    "custom/battery": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/rice-battery",
        "interval": 30,
        "signal": 8,
        "tooltip": true
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/rice-power"
    },
    "niri/workspaces": {
        "format": "{value}",
        "display-condition": "keep-named"
    },
    "niri/window": {
        "format": "{}",
        "max-length": 25,
        "separate-outputs": true
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "max-volume": 100
    }
}
