// MacBook10,1. Omit mode to use the panel's preferred EDID mode.
output "eDP-1" {
    scale 2.0
}

input {
    keyboard {
        xkb {
            layout "us,ru"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
        scroll-factor 0.5
    }
}

cursor {
    xcursor-theme "capitaine-cursors"
    xcursor-size 24
}

xwayland-satellite {
    off
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "../macbook-rice/themes/current/layout.kdl"

animations {
    slowdown 0.8
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Alt+Space hotkey-overlay-title="Application launcher" { spawn "fuzzel"; }
    Super+Space repeat=false { switch-layout "next"; }
    Super+Backslash repeat=false hotkey-overlay-title="Toggle Waybar" { spawn "pkill" "-USR1" "-x" "waybar"; }
    Mod+B hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="Thunar" { spawn "thunar"; }
    Mod+Q repeat=false { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+V { toggle-window-floating; }
    Mod+L repeat=false hotkey-overlay-title="Lock screen" { spawn "systemctl" "--user" "start" "macbook-rice-lock.service"; }
    Mod+Slash { show-hotkey-overlay; }
    Mod+Shift+Q { quit; }
    Mod+Escape repeat=false hotkey-overlay-title="Power menu" { spawn-sh "exec ~/.local/bin/rice-power"; }
    Mod+Shift+C hotkey-overlay-title="Clipboard history" { spawn-sh "exec ~/.local/bin/rice-clipboard"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn "swaync-client" "-t" "-sw"; }
    Mod+Shift+N hotkey-overlay-title="Do not disturb" { spawn "swaync-client" "-d" "-sw"; }
    Mod+Shift+T repeat=false hotkey-overlay-title="Switch theme" { spawn-sh "exec ~/.local/bin/rice-theme"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-window-to-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+3 { move-window-to-workspace "3"; }
    Mod+Shift+4 { move-window-to-workspace "4"; }
    Mod+Shift+5 { move-window-to-workspace "5"; }

    Print { screenshot-screen; }
    Mod+Shift+S { screenshot; }
    Mod+Shift+P { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "--min-value=1" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "--min-value=1" "set" "5%-"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "playerctl" "previous"; }
}
