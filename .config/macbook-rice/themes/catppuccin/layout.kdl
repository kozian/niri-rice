layout {
    gaps 10
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 2
        active-gradient from="#89b4fa" to="#cba6f7" angle=45
        inactive-color "#585b70"
    }
    struts {
        left 2
        right 2
    }
}
